# Copy to .env and fill locally. Never commit credentials.
TRUST_MODEL_NAME=
TRUST_MODEL_PROVIDER=openai_compatible
TRUST_MODEL_API_KEY=
TRUST_MODEL_BASE_URL=https://api.openai.com/v1
TRUST_MODEL_TIMEOUT_SECONDS=90
TRUST_MODEL_MAX_RETRIES=1
TRUST_MODEL_MAX_OUTPUT_TOKENS=8192
# Stage budgets (effective value is at least the legacy global budget, capped below).
TRUST_MODEL_EXTRACTION_MAX_OUTPUT_TOKENS=32768
TRUST_MODEL_ANALYSIS_MAX_OUTPUT_TOKENS=32768
TRUST_MODEL_ARBITRATION_MAX_OUTPUT_TOKENS=65536
# Provider-confirmed length truncation only: at most two larger fresh stage requests.
TRUST_MODEL_CAPACITY_MAX_OUTPUT_TOKENS=131072
TRUST_MODEL_CAPACITY_RETRIES=2
TRUST_MODEL_GENERATION_TIMEOUT_SECONDS=600
# Experimental v18 quote-faithful bank + purpose review; default remains v17.
# The fixed pilot did not improve precision/recall. Enable only for explicit research.
TRUST_MODEL_PREMISE_BANK_ENABLED=false
# DeepSeek optional controls: enabled/disabled and low/high/max.
# TRUST_MODEL_THINKING=enabled
# TRUST_MODEL_REASONING_EFFORT=low
TRUST_LOCAL_ACTOR=local-operator
TRUST_RETRIEVAL_LIMIT=16
# Full-source scan targets. A larger immutable paragraph runs alone up to the
# source catalog hard limit (64000 codepoints / 512 spans); nothing is dropped.
TRUST_SOURCE_BATCH_CODEPOINTS=20000
TRUST_SOURCE_BATCH_SPANS=128
